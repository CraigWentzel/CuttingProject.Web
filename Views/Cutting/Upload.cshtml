@{
    ViewData["Title"] = "Upload";
}

<div class="page-header">
    <h1><i class="bi bi-upload me-2"></i>Upload Cutting List</h1>
    <p>Upload a PDF parts list to extract and allocate cutting bins</p>
</div>

@* Step indicator *@
<div class="step-bar">
    <div class="step active">
        <div class="step-circle">1</div>
        <span>Upload PDF</span>
    </div>
    <div class="step-line"></div>
    <div class="step">
        <div class="step-circle">2</div>
        <span>Review Parts</span>
    </div>
    <div class="step-line"></div>
    <div class="step">
        <div class="step-circle">3</div>
        <span>Bin Allocation</span>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-exclamation-triangle-fill"></i>
        @foreach (var error in ViewData.ModelState.Values
            .SelectMany(v => v.Errors))
        {
            <span>@error.ErrorMessage</span>
        }
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header-primary">
                <i class="bi bi-file-earmark-pdf"></i>
                Select Parts List PDF
            </div>
            <div class="card-body p-4">

                <form method="post"
                      asp-controller="Cutting"
                      asp-action="Upload"
                      enctype="multipart/form-data"
                      id="uploadForm">

                    <div class="upload-zone" id="uploadZone">
                        <i class="bi bi-cloud-arrow-up upload-icon"></i>
                        <h4>Drag & Drop your PDF here</h4>
                        <p>or click the button below to browse</p>

                        <input type="file"
                               name="pdfFile"
                               id="pdfFile"
                               accept=".pdf"
                               class="d-none" />

                        <button type="button"
                                class="btn-primary-app"
                                onclick="document.getElementById('pdfFile').click()">
                            <i class="bi bi-folder2-open"></i>
                            Browse Files
                        </button>
                    </div>

                    <div id="fileInfo" class="mt-3 d-none">
                        <div class="d-flex align-items-center gap-2 p-3
                                    rounded border border-success bg-light">
                            <i class="bi bi-file-earmark-check-fill
                                      text-success fs-5"></i>
                            <div>
                                <div class="fw-semibold" id="fileName"></div>
                                <div class="text-muted small" id="fileSize"></div>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit"
                                class="btn-primary-app justify-content-center py-2"
                                id="btnSubmit"
                                disabled>
                            <i class="bi bi-arrow-right-circle"></i>
                            Extract Parts List
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const zone     = document.getElementById('uploadZone');
        const input    = document.getElementById('pdfFile');
        const fileInfo = document.getElementById('fileInfo');
        const fileName = document.getElementById('fileName');
        const fileSize = document.getElementById('fileSize');
        const btnSubmit = document.getElementById('btnSubmit');

        function showFile(file) {
            if (!file || file.type !== 'application/pdf') return;
            fileName.textContent = file.name;
            fileSize.textContent = (file.size / 1024).toFixed(1) + ' KB';
            fileInfo.classList.remove('d-none');
            btnSubmit.removeAttribute('disabled');
        }

        input.addEventListener('change', () => showFile(input.files[0]));

        zone.addEventListener('dragover', e => {
            e.preventDefault();
            zone.classList.add('dragover');
        });

        zone.addEventListener('dragleave', () => zone.classList.remove('dragover'));

        zone.addEventListener('drop', e => {
            e.preventDefault();
            zone.classList.remove('dragover');
            const file = e.dataTransfer.files[0];
            const dt   = new DataTransfer();
            dt.items.add(file);
            input.files = dt.files;
            showFile(file);
        });

        uploadForm.addEventListener('submit', () => {
            btnSubmit.disabled = true;
            btnSubmit.innerHTML = `
                <span class="spinner-border spinner-border-sm me-2"
                      role="status" aria-hidden="true"></span>
                           Extracting Parts...`;
        });
    </script>
}