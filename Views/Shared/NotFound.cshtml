@{
    Layout = "_Layout";
    ViewData["Title"] = "Not Found";
}

<div class="text-center py-5">
    <div style="font-size: 5rem; color: var(--border);">
        <i class="bi bi-exclamation-circle"></i>
    </div>
    <h1 style="font-size: 2rem; color: var(--primary); font-weight: 800;">Page Not Found</h1>
    <p class="text-muted mb-4">The page you're looking for doesn't exist.</p>
    <a asp-controller="Home" asp-action="Index" class="btn-primary-app">
        <i class="bi bi-house"></i> Back to Home
    </a>
</div>